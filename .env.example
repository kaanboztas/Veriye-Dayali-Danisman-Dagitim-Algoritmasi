# ==============================================================================
# ÇEVRE VE KONFİGÜRASYON ŞABLONU (.env.example)
# ==============================================================================
# Bu dosya bir güvenlik şablonudur. Gerçek hiçbir anahtar veya sır içermez.
# Yeni bir sunucu veya harici servis entegre edildiğinde bu dosyayı .env olarak
# kopyalayabilir ve ortam değişkenlerinizi ekleyebilirsiniz.

# İstemci / Sunucu Portu
APP_PORT=3000
APP_ENV=production

# Olası Harici API Entegrasyonları (Şablon)
EXTERNAL_API_URL=
EXTERNAL_API_KEY=YOUR_API_KEY_HERE
API_SECRET_TOKEN=YOUR_SECRET_TOKEN_HERE

# Veri Tabanı / Depolama Bağlantısı (İsteğe Bağlı)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
